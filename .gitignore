__pycache__/
*.pyc
*.pyo
*.pyd
.env
.DS_Store
petcare_execution/evidence_output/
petcare_web/.next/
petcare_web/node_modules/

# Environment files. Only bare `.env` was covered, which misses the file
# Next.js itself tells developers to put local secrets in (`.env.local`) and
# every `.env.*.local` variant. This repository is PUBLIC, so an unignored
# env file is a one-command secret leak. `.env.example` stays tracked.
.env
.env.*
!.env.example
!.env*.example

# claude-flow hook state. The hook writes `.claude-flow/policy/state.json` into
# whatever directory the shell is in, and staging that directory sweeps it in
# (D2M-TOOLING-LOG-IN-EVIDENCE). It is local tooling state, never evidence.
# Untracked under Sponsor ruling R21.3 after a by-path secret scan (CLEAN).
.claude-flow/
